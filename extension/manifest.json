{
  "manifest_version": 3,
  "name": "字幕口袋 · Netflix 英文學習",
  "version": "0.9.2",
  "description": "點選 Netflix 英文字幕，翻譯成繁體中文，收藏單字、片語與句子；逐字稿可停靠四邊或半透明浮動。",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://translation.googleapis.com/*"
  ],
  "optional_host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "js": [
        "player-bridge.js",
        "auto-captions.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "js": [
        "layout.js",
        "transcript.js",
        "review.js",
        "transcript-ui.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "字幕口袋",
    "default_popup": "popup.html"
  },
  "options_page": "library.html"
}
